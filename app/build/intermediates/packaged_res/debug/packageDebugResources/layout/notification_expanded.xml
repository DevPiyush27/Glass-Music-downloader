<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_notif_container"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- Top: Spotify-Style Song Display (Seamless, No Extra Boxes, No Borders) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@android:color/transparent"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <!-- Album Art with Smooth Curves (No Border) -->
        <ImageView
            android:id="@+id/iv_expanded_art"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher"
            android:background="@drawable/bg_notif_art_curved"
            android:clipToOutline="true" />

        <!-- Song Metadata -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/tv_expanded_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#1C1B1F"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Audio Aurora" />

            <TextView
                android:id="@+id/tv_expanded_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#5E172D"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Unknown Artist" />

            <TextView
                android:id="@+id/tv_expanded_album"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#7D3C50"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Single" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom: Row of 6 Frameless Control Buttons (No Extra Boxes, No Borders) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:weightSum="6">

        <!-- 1. Previous -->
        <ImageButton
            android:id="@+id/btn_notif_prev"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/bg_notif_button"
            android:scaleType="centerInside"
            android:padding="6dp"
            android:src="@drawable/ic_previous"
            android:contentDescription="Previous Track" />

        <!-- 2. Rewind (-10s) -->
        <ImageButton
            android:id="@+id/btn_notif_rewind"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/bg_notif_button"
            android:scaleType="centerInside"
            android:padding="6dp"
            android:src="@drawable/ic_rewind_10"
            android:contentDescription="Rewind 10 Seconds" />

        <!-- 3. Play / Pause -->
        <ImageButton
            android:id="@+id/btn_notif_play_pause"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/bg_notif_button_play"
            android:scaleType="centerInside"
            android:padding="6dp"
            android:src="@drawable/ic_play"
            android:contentDescription="Play or Pause" />

        <!-- 4. Fast Forward (+10s) -->
        <ImageButton
            android:id="@+id/btn_notif_forward"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/bg_notif_button"
            android:scaleType="centerInside"
            android:padding="6dp"
            android:src="@drawable/ic_forward_10"
            android:contentDescription="Fast Forward 10 Seconds" />

        <!-- 5. Next -->
        <ImageButton
            android:id="@+id/btn_notif_next"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/bg_notif_button"
            android:scaleType="centerInside"
            android:padding="6dp"
            android:src="@drawable/ic_next"
            android:contentDescription="Next Track" />

        <!-- 6. Queue -->
        <ImageButton
            android:id="@+id/btn_notif_queue"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/bg_notif_button"
            android:scaleType="centerInside"
            android:padding="6dp"
            android:src="@drawable/ic_queue"
            android:contentDescription="Playlists and Queue" />
    </LinearLayout>
</LinearLayout>
